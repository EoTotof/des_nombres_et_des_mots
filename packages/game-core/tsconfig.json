{
  "extends": "../../tsconfig.base.json",

  "compilerOptions": {
    "module": "es2022",
    "moduleResolution": "bundler",
    "declaration": true,
    "emitDeclarationOnly": false,
    "outDir": "./dist",
    "rootDir": ".",
    "sourceMap": true,
    "composite": true,
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": [
    "index.ts",
    "data/**/*.json",
    "src/**/*",
    "test/**/*"
  ]
}