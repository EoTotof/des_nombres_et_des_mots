{
  "editor.tabSize": 2,

  "eslint.useFlatConfig": true,
  "eslint.format.enable": true,

  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],

  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ],

  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  }
}